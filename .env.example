# Local single-user server. Leave HOST at 127.0.0.1 unless you trust your LAN.
HOST=127.0.0.1
PORT=3001
# Optional private runtime directory; never expose it through the frontend.
# DATA_DIR=./data
# Enable only when served over HTTPS behind the appropriate reverse proxy.
# AUTH_COOKIE_SECURE=true
# Trust one reverse proxy hop only for the Docker/Caddy deployment.
# TRUST_PROXY=1
# Public domain used by compose.yaml and Caddy; omit for initial HTTP setup.
# DOMAIN=kaopu.example.com
# Optional Docling overrides. Defaults are the project-local isolated
# .venv-docling interpreter and .local/docling-models. See docs/docling-integration.md.
# DOCLING_PYTHON=
# DOCLING_ARTIFACTS_PATH=
# Use 设置 → API 与模型 to test and save text/vision connections without restart.
# Secrets stay in the private data directory and are never returned to the browser.
# Optional environment defaults for an OpenAI-compatible /chat/completions provider.
# Base URL must include the provider's API prefix (for example /v1).
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# Optional separate vision provider. The settings UI can also share the text provider.
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=
# Without all three, document retrieval works locally and no text is sent to a model.

# Frame capture defaults to the bundled Windows x64 FFmpeg; no Python is required.
# The compressed binary is unpacked into DATA_DIR/runtime on first use.
# On other systems install FFmpeg yourself or set LESSON_FFMPEG to its absolute path.
# LESSON_FFMPEG=
# Optional legacy Python/PyAV/yt-dlp capture backend; only for existing deployments.
# LESSON_CAPTURE_BACKEND=python

# Optional local Bilibili speech transcription. Disabled by default.
# Requires Python, yt-dlp, faster-whisper, av, imageio-ffmpeg and a locally cached
# Systran/faster-whisper-base model. Never downloads a model automatically.
# Processes one public BV part at a time, up to 120 minutes / 96 MB of audio.
# Audio transcription and frame capture each have a 30-minute processing timeout.
# LOCAL_TRANSCRIPTION=1
# LOCAL_TRANSCRIPTION_PYTHON=python
# LOCAL_TRANSCRIPTION_MODEL=auto
# LOCAL_TRANSCRIPTION_DEVICE=cpu
# LOCAL_TRANSCRIPTION_LANGUAGE=zh

# Optional separate BiliNote v2.4.x service, configured by the service owner.
# No browser cookies are read or accepted by Kaopu.
# BILINOTE_BASE_URL=http://127.0.0.1:8483
# BILINOTE_PROVIDER_ID=
# BILINOTE_MODEL=
# BILINOTE_API_TOKEN=
