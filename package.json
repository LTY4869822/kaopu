{
  "name": "shifen-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "recover": "node scripts/recover-account.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:batch": "node scripts/batch-import-smoke.mjs",
    "test:workspace": "node scripts/workspace-ui-smoke.mjs",
    "test:planner": "node scripts/planner-smoke.mjs",
    "test:statue": "node scripts/statue-smoke.mjs",
    "setup:pdf": "playwright install chromium",
    "test:documents": "node --test tests/study-document.test.mjs",
    "test:documents:ui": "node scripts/studio-document-ui-smoke.mjs",
    "test:recovery": "node scripts/chunk-recovery-ui-smoke.mjs",
    "package:handover": "node scripts/package-handover.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@napi-rs/canvas": "^0.1.80",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "mammoth": "^1.11.0",
    "markdown-it": "^15.0.3",
    "multer": "^2.0.2",
    "pagedjs": "^0.4.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
